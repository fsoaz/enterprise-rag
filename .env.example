# Application
DATABASE_URL=postgresql+asyncpg://rag_app:rag_app@localhost:15432/enterprise_rag
DATABASE_URL_SYNC=postgresql+psycopg://rag_app:rag_app@localhost:15432/enterprise_rag
DATABASE_URL_MIGRATE=postgresql+psycopg://rag_migrate:rag_migrate@localhost:15432/enterprise_rag
DATABASE_URL_MAINT=postgresql+asyncpg://rag_maint:rag_maint@localhost:15432/enterprise_rag
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2

# Object storage (MinIO)
S3_ENDPOINT_URL=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=enterprise-rag
S3_REGION=us-east-1

# Auth (Keycloak)
OIDC_ISSUER=http://localhost:8080/realms/enterprise-rag
OIDC_AUDIENCE=enterprise-rag-api
OIDC_JWKS_URL=http://localhost:8080/realms/enterprise-rag/protocol/openid-connect/certs
# DANGER: DEV_AUTH_BYPASS=true trusts the X-Dev-User header verbatim — any caller can
# impersonate any user. Local development only. Never set true outside a dev machine.
# The compose stack sets it to true explicitly; leave it false here so a copied .env is safe.
DEV_AUTH_BYPASS=false

# Inference
INFERENCE_BASE_URL=http://localhost:8001
INFERENCE_SERVICE_TOKEN=dev-inference-token

# LLM
ANTHROPIC_API_KEY=sk-ant-replace-me
LLM_PRIMARY_MODEL=claude-opus-5
LLM_JUDGE_MODEL=claude-haiku-4-5
LLM_FALLBACK_MODEL=claude-sonnet-5

# App
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
EMBEDDING_DIM=1024
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_VERSION=stub-v0
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
INGEST_SYNC=true
