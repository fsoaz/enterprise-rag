[importlinter]
root_packages =
    domain
    db
    retrieval
    llm
    observability
    evaluation
    api
    worker
    inference
    evals

[importlinter:contract:domain-independence]
name = domain imports nothing from the project
type = forbidden
source_modules =
    domain
forbidden_modules =
    db
    retrieval
    llm
    observability
    evaluation
    api
    worker
    inference
    evals

[importlinter:contract:packages-no-apps]
name = packages never import apps
type = forbidden
source_modules =
    domain
    db
    retrieval
    llm
    observability
    evaluation
forbidden_modules =
    api
    worker
    inference

[importlinter:contract:api-worker-isolation]
name = api and worker do not import each other
type = forbidden
source_modules =
    api
forbidden_modules =
    worker
ignore_imports =
    api.services.ingest -> worker.tasks.ingest

[importlinter:contract:worker-api-isolation]
name = worker does not import api
type = forbidden
source_modules =
    worker
forbidden_modules =
    api

[importlinter:contract:inference-isolation]
name = inference only may import observability
type = forbidden
source_modules =
    inference
forbidden_modules =
    domain
    db
    retrieval
    llm
    evaluation
    api
    worker
    evals

[importlinter:contract:evaluation-scope]
name = evaluation imports only domain and db from the project
type = forbidden
source_modules =
    evaluation
forbidden_modules =
    retrieval
    llm
    observability
    api
    worker
    inference
    evals

# evals/ is offline tooling, fixtures, and datasets. No deployable image contains it,
# so a product import of it builds cleanly and fails at startup (R-124, ADR-016).
[importlinter:contract:product-never-imports-evals]
name = product code never imports the offline evals tooling
type = forbidden
source_modules =
    domain
    db
    retrieval
    llm
    observability
    evaluation
    api
    worker
    inference
forbidden_modules =
    evals
