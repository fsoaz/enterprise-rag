# Browser-visible values are compiled into the client bundle.
NEXT_PUBLIC_DEV_AUTH=false
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Server-only BFF/OIDC configuration. Never prefix secrets with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:8080/realms/enterprise-rag
OIDC_CLIENT_ID=enterprise-rag-web
# OIDC_CLIENT_SECRET=replace-for-a-confidential-client
# AUTH_COOKIE_SECURE=true
